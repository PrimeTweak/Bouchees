server/accounts.json
server/ratings.json

# Les photos générées SONT versionnées : c'est ce qui les fait monter sur
# GitHub, puis sur le serveur, puis dans l'app. Sans ça, elles restent sur
# ton Mac et l'app ne les voit jamais.
#
# Le dépôt grossira — compte 15 à 20 Mo pour quarante photos. Quand ça
# deviendra lourd, on passera à un stockage d'images séparé et cette ligne
# reviendra :
#   images/
node_modules/
.DS_Store

# Le projet Xcode est GÉNÉRÉ par XcodeGen à partir de ios/project.yml.
# Ne jamais le versionner : c'est la source de la moitié des conflits Git
# d'un projet iOS, et ici il n'a aucune valeur — il se refabrique en 2 s.
ios/App.xcodeproj/
ios/*.xcworkspace/
build/
sortie/

# Ressources embarquées au moment du build (moteur JS, tables, lots libres).
# Le workflow les copie avant XcodeGen — rien à suivre ici.
ios/App/App/Bundled/

# Rejected images: written for inspection, never published.
images/rejected/

# The vision key, written by PHOTOS.command. Never leaves this machine.
.env
