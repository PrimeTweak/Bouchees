# Le projet Xcode est GÉNÉRÉ par XcodeGen à partir de ios/project.yml.
# Ne jamais le versionner : c'est la source de la moitié des conflits Git
# d'un projet iOS, et ici il n'a aucune valeur — il se refabrique en 2 s.
ios/App.xcodeproj/
ios/*.xcworkspace/
build/
sortie/

# Contenu embarqué au moment du build, pas à la main
ios/App/App/web/index.html
ios/App/App/web/lots/
ios/App/App/web/securite.json
