[{"id":"silky-hummus","name":"Silky hummus","category":"Snack","servings":"500 ml","minAgeMonths":6,"timeMinutes":10,"ingredients":[{"id":"chickpeas","qty":540,"unit":"ml","role":"protein"},{"id":"tahini","qty":45,"unit":"ml","role":"fat"},{"id":"olive_oil","qty":45,"unit":"ml"},{"id":"lemon_juice","qty":30,"unit":"ml"},{"id":"garlic","qty":1,"unit":"gousse"},{"id":"water","qty":60,"unit":"ml","role":"liquid"}],"steps":["Rinse the chickpeas in warm water.","Blend all the ingredients until very smooth.","Loosen with water as needed — smoother for younger children."],"batch":"2026-07"},{"id":"banana-bread","name":"Banana bread","category":"Snack","servings":"1 loaf","minAgeMonths":9,"timeMinutes":70,"ingredients":[{"id":"mashed_banana","qty":375,"unit":"ml"},{"id":"wheat_flour","qty":375,"unit":"ml","role":"flour"},{"id":"egg","qty":2,"unit":"unit","role":"binder"},{"id":"butter","qty":80,"unit":"g","role":"fat"},{"id":"sugar","qty":60,"unit":"ml"},{"id":"baking_powder","qty":5,"unit":"ml"},{"id":"baking_soda","qty":2,"unit":"ml"},{"id":"vanilla","qty":5,"unit":"ml"}],"steps":["Preheat the oven to 180 °C.","Beat the melted butter, sugar, eggs and vanilla.","Fold in the bananas, then the dry ingredients.","Bake in a loaf pan for 55 to 60 minutes."],"batch":"2026-07"},{"id":"oatmeal-raisin-cookies","name":"Oatmeal raisin cookies","category":"Snack","servings":"20 cookies","minAgeMonths":12,"timeMinutes":30,"ingredients":[{"id":"rolled_oats","qty":375,"unit":"ml"},{"id":"wheat_flour","qty":250,"unit":"ml","role":"flour"},{"id":"butter","qty":125,"unit":"g","role":"fat"},{"id":"sugar","qty":125,"unit":"ml"},{"id":"egg","qty":1,"unit":"unit","role":"binder"},{"id":"raisins","qty":125,"unit":"ml"},{"id":"cinnamon","qty":2,"unit":"ml"},{"id":"baking_soda","qty":2,"unit":"ml"}],"steps":["Cream the butter and sugar, then add the egg.","Fold in the dry ingredients, then the raisins.","Drop flattened balls onto a baking sheet.","Bake at 180 °C for 10 to 12 minutes."],"batch":"2026-07"},{"id":"mini-vegetable-frittatas","name":"Mini vegetable frittatas","category":"Breakfast","servings":"8 mini frittatas","minAgeMonths":6,"timeMinutes":30,"ingredients":[{"id":"egg","qty":4,"unit":"unit","role":"protein"},{"id":"zucchini","qty":1,"unit":"unité râpée"},{"id":"spinach","qty":60,"unit":"ml hachés"},{"id":"cheddar","qty":80,"unit":"g","role":"dairy"},{"id":"cow_milk","qty":60,"unit":"ml","role":"liquid"},{"id":"olive_oil","qty":10,"unit":"ml","role":"fat"}],"steps":["Preheat the oven to 180 °C and oil 8 muffin cups.","Whisk the eggs with the milk.","Add the drained vegetables and the cheese.","Bake for 18 to 20 minutes, until the centre is set."],"batch":"2026-07"},{"id":"squash-and-coconut-soup","name":"Squash and coconut soup","category":"Meal","servings":"4 servings","minAgeMonths":6,"timeMinutes":35,"ingredients":[{"id":"butternut_squash","qty":1,"unit":"unit"},{"id":"coconut_milk","qty":250,"unit":"ml","role":"liquid"},{"id":"unsalted_broth","qty":500,"unit":"ml"},{"id":"onion","qty":1,"unit":"unit"},{"id":"olive_oil","qty":15,"unit":"ml","role":"fat"}],"steps":["Soften the onion in the oil.","Add the cubed squash and the broth, then simmer for 20 minutes.","Blend with the coconut milk until velvety."],"batch":"2026-07"},{"id":"mac-and-cheese-with-hidden-squash","name":"Mac and cheese with hidden squash","category":"Meal","servings":"4 servings","minAgeMonths":9,"timeMinutes":30,"ingredients":[{"id":"wheat_pasta","qty":300,"unit":"g","role":"flour"},{"id":"cheddar","qty":250,"unit":"ml râpé","role":"dairy"},{"id":"cow_milk","qty":250,"unit":"ml","role":"liquid"},{"id":"butternut_squash","qty":250,"unit":"ml en purée"},{"id":"butter","qty":30,"unit":"g","role":"fat"},{"id":"wheat_flour","qty":30,"unit":"ml","role":"binder"},{"id":"salt","qty":1,"unit":"ml"}],"steps":["Cook the pasta and set aside.","Make a roux with the butter and flour, then pour in the milk.","Stir in the squash purée and the cheese off the heat.","Toss with the pasta."],"batch":"2026-07"},{"id":"turkey-and-apple-meatballs","name":"Turkey and apple meatballs","category":"Meal","servings":"20 meatballs","minAgeMonths":9,"timeMinutes":35,"ingredients":[{"id":"ground_turkey","qty":450,"unit":"g","role":"protein"},{"id":"apple","qty":1,"unit":"unité râpée"},{"id":"egg","qty":1,"unit":"unit","role":"binder"},{"id":"breadcrumbs","qty":125,"unit":"ml","role":"binder"},{"id":"dijon_mustard","qty":5,"unit":"ml","role":"seasoning"},{"id":"garlic","qty":1,"unit":"gousse"},{"id":"salt","qty":1,"unit":"ml"}],"steps":["Mix all the ingredients without overworking the meat.","Shape into meatballs the size of a ping-pong ball.","Bake at 200 °C for 18 to 20 minutes.","Mash or quarter them for younger children."],"batch":"2026-07"}]
