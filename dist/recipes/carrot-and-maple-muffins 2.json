{"id":"carrot-and-maple-muffins","ingredients":[{"id":"wheat_flour","qty":375,"unit":"ml"},{"id":"carrot","qty":250,"unit":"ml"},{"id":"egg","qty":2,"unit":"unit","role":"binder"},{"id":"applesauce","qty":125,"unit":"ml","role":"binder"},{"id":"canola_oil","qty":80,"unit":"ml","role":"fat"},{"id":"maple_syrup","qty":80,"unit":"ml"},{"id":"baking_powder","qty":10,"unit":"ml"},{"id":"cinnamon","qty":5,"unit":"ml"}],"steps":["Preheat the oven to 180 °C.","Mix the eggs, applesauce, oil and syrup.","Fold in the flour, baking powder and cinnamon, then the carrots.","Bake in muffin cups for 18 to 20 minutes."]}
