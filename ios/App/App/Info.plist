<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDisplayName</key><string>Bouchées</string>
  <key>CFBundleIdentifier</key><string>ca.bouchees.app</string>
  <key>CFBundleName</key><string>Bouchees</string>
  <key>CFBundleShortVersionString</key><string>0.6.0</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>LSRequiresIPhoneOS</key><true/>
  <key>UILaunchScreen</key><dict/>
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>

  <!-- Texte montré au moment de la demande. Apple rejette les formulations
       vagues : on dit exactement à quoi sert la caméra. -->
  <key>NSCameraUsageDescription</key>
  <string>Bouchées utilise la caméra pour lire le code-barres d'un produit et vérifier sa liste d'ingrédients. Aucune photo n'est enregistrée ni envoyée.</string>

  <!-- Rien d'autre n'est demandé : ni localisation, ni contacts, ni photos. -->
</dict>
</plist>
